# Wojtek Stock settings. Copy to stock.env, fill in, and lock it down:
#   cp stock.env.example stock.env && chmod 600 stock.env
# After changing anything here:  sudo docker compose up -d   (in ~/wojtek-stock)

# ---------------------------------------------------------------- the web page
# Sign-in for the page. Station computers can use terminal keys instead (People tab), so the password stays with you.
STOCK_USER=shop
STOCK_PASSWORD=change-this-to-something-long

# ---------------------------------------------------------------- WooCommerce
# Your store's address (https://, no trailing slash) and a REST API key with Read/Write permission:
# WordPress admin > WooCommerce > Settings > Advanced > REST API > Add key. Pick an admin or shop manager user,
# Permissions: Read/Write. Copy both keys straight away: WooCommerce shows the secret only once.
WOO_URL=https://www.example.com
WOO_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOO_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# What happens to changes:
#   dryrun = every change is checked against the live store and logged, nothing is sent (start here)
#   on     = changes are sent to WooCommerce, then read back to confirm they took
#   off    = changes are refused
WOO_WRITE=dryrun

# How the key is sent: auto (the usual header, falling back to the address if your host drops the header),
# basic (header only) or query (address only).
WOO_AUTH=auto
# Seconds to wait for one WooCommerce reply, and the pause between requests (to go easy on a live website)
WOO_TIMEOUT=60
WOO_MIN_GAP=0.25

# ---------------------------------------------------------------- what is never changed
# Distributor feed SKU prefixes. You tick these on the Setup page from the SKUs actually in your store; any listed
# here are added to those and can't be unticked on the page. A product whose SKU (or whose parent's SKU) starts with
# one of these is never shown at the station and never changed.
FEED_PREFIXES=

# Serialized gun categories, by name, slug or id (also ticked on the Setup page). Never changed here.
GUN_CATEGORIES=

# ---------------------------------------------------------------- the local copy of the product list
# A quick sync (products changed and orders placed since the last one) every this many minutes,
# and a full sync every night at this shop time.
SYNC_MINUTES=10
FULL_SYNC_TIME=03:15
SHOP_TZ=America/New_York
# If WooCommerce suddenly returns far fewer products than before, the local copy is kept and the Setup page says why.
# Set to on for one sync if a big drop is real (you deleted a feed), then back to off.
ALLOW_BIG_DROP=off

# ---------------------------------------------------------------- Adjust reasons (comma-separated)
# "Other" always needs a note.
ADJUST_DOWN_REASONS=Damaged,Used on gunsmithing job,Returned to vendor,Theft/loss,Other
ADJUST_UP_REASONS=Found,Customer return,Count correction,Other

# ---------------------------------------------------------------- new SKUs for products that have none
# Generated SKUs look like WW-000123, continuing after the highest one already in the store.
# Must not start like a feed prefix.
SKU_PREFIX=WW-
SKU_DIGITS=6

# ---------------------------------------------------------------- labels on a network Zebra printer (optional)
# Same setting names as the Wojtek Locator, so you can copy its lines once its layout is settled.
# The printer's address on your network, optionally :port (9100 is standard). Blank = labels are made as PDFs.
LABEL_PRINTER=
# 203 for most Zebra desktop printers, 300 for the 300 dpi models
LABEL_DPI=203
# The label size the Labels tab starts from, inches: across the print head, then length. The Labels tab's Size picker
# sends whatever you choose there (2 x 3 upright, 2 x 1...) to the Zebra, so this is only the default.
LABEL_WIDTH_IN=2
LABEL_LENGTH_IN=3
